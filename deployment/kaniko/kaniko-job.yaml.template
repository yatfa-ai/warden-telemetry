# Kaniko Job template for warden-telemetry. Variables substituted by build.sh
# / GitHub Actions.
#
# Placeholders:
#   __GIT_REF__     e.g. main or refs/tags/v1.2.3
#   __IMAGE_TAG__   e.g. sha-abc1234
#   __REPO_URL__    e.g. github.com/yatfa-ai/warden-telemetry.git
#   __JOB_NAME__    unique job name per build, e.g. warden-telemetry-build-sha-abc1234
#
# Kaniko clones the repo in-pod (no ConfigMap tarball needed), builds the
# single-stage Dockerfile, and pushes to the in-cluster registry at
# registry.default.svc.cluster.local:5000. There is no --target — the Dockerfile
# is single-stage. Mirrors yatfa's kaniko-job.yaml.template (minus --target).
apiVersion: batch/v1
kind: Job
metadata:
  name: __JOB_NAME__
  namespace: default
  labels:
    app: warden-telemetry
    component: kaniko-build
spec:
  backoffLimit: 1
  ttlSecondsAfterFinished: 86400
  template:
    spec:
      restartPolicy: Never
      imagePullSecrets:
        - name: yatfa-registry-pull
      containers:
        - name: kaniko
          image: gcr.io/kaniko-project/executor:v1.24.0
          imagePullPolicy: IfNotPresent
          args:
            - --dockerfile=Dockerfile
            - --context=git://__REPO_URL__#__GIT_REF__
            - --context-sub-path=/
            # Push to the in-cluster ClusterIP directly. The public hostname
            # (registry.tinkerai.win) sits behind Cloudflare, whose free plan
            # caps request bodies at 100MB — image layers routinely exceed that
            # and 413 mid-push. The image lands at the same registry path, so
            # Deployments pull via the external DNS as before.
            - --destination=registry.default.svc.cluster.local:5000/warden-telemetry:__IMAGE_TAG__
            # Also tag :latest so the base Deployment manifest (which references
            # warden-telemetry:latest) stays pullable before the explicit tag is
            # pinned. build.sh re-pins the live Deployment to the sha-<sha> tag.
            - --destination=registry.default.svc.cluster.local:5000/warden-telemetry:latest
            - --insecure
            - --cache=false
            - --snapshot-mode=full
          env:
            - name: DOCKER_CONFIG
              value: /kaniko/.docker
            # GitHub token for cloning the PRIVATE repo. `x-access-token` is
            # GitHub's conventional username for token auth. From a laptop run,
            # build.sh passes `gh auth token`; from the in-cluster release Job,
            # the GitHub App installation token (see deployment/release/).
            - name: GIT_USERNAME
              value: x-access-token
            - name: GIT_PASSWORD
              value: __GIT_PASSWORD__
          volumeMounts:
            - name: docker-config
              mountPath: /kaniko/.docker
              readOnly: true
          resources:
            requests:
              cpu: "500m"
              memory: "1Gi"
            limits:
              cpu: "2"
              memory: "4Gi"
      volumes:
        - name: docker-config
          secret:
            secretName: yatfa-registry-pull
            items:
              - key: .dockerconfigjson
                path: config.json
