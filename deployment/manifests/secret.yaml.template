# Warden Telemetry secret values. RENDERED — do not commit secret.yaml.
#
# Render with deployment/manifests/render-secret.sh, which generates AUTH_TOKEN
# (32-byte hex) on first run and PRESERVES it from the live warden-telemetry-secret
# when already present — rotating AUTH_TOKEN silently breaks every warden client
# pointing at this receiver until they're reconfigured with the new token, so it
# must never be regenerated blindly.
#
# Output is deployment/manifests/secret.yaml (gitignored — see deployment/.gitignore).
#
# Placeholder:
#   __AUTH_TOKEN__   32-byte hex shared secret. Every route (/ingest, /summary,
#                   /capabilities, /events) requires `Authorization: Bearer
#                   <AUTH_TOKEN>`. The warden client is configured with the same
#                   value + endpointUrl = https://telemetry.yatfa.ai/ingest.
apiVersion: v1
kind: Secret
metadata:
  name: warden-telemetry-secret
  namespace: default
  labels:
    app: warden-telemetry
type: Opaque
stringData:
  AUTH_TOKEN: "__AUTH_TOKEN__"
